#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

# 切換到 .dotfiles 根目錄
cd "$(dirname $0)"/..
DOTFILES_ROOT=$(pwd) # 取得當前絕對路徑，比寫死 $HOME/.dotfiles 更靈活

echo "🚀 Starting Dotfiles Installation from: $DOTFILES_ROOT"

# -----------------------------------------------------------
# 1. 安裝核心軟體 (Core Software)
# -----------------------------------------------------------
echo "› brew bundle (Core Software) | 安裝核心軟體"
# 加入 --verbose 以便在舊機器上觀察進度
brew bundle --verbose --file="Brewfile" || true

# -----------------------------------------------------------
# 2. 安裝字體 (Fonts) - 獨立處理
# -----------------------------------------------------------
if [ -f "Brewfile.fonts" ]; then
    echo "› brew bundle (Fonts) | 安裝字體"
    brew bundle --verbose --file="Brewfile.fonts" || true
else
    echo "› Warning: Brewfile.fonts not found, skipping fonts. | 找不到字體清單，跳過"
fi

# -----------------------------------------------------------
# 3. 其他特定安裝與設定
# -----------------------------------------------------------

# Yabai Window Manager (Only for Apple Silicon)
if [[ $(uname -m) == 'arm64' ]]; then
    echo "› Apple Silicon detected. Configuring Yabai..."
    if brew list yabai &>/dev/null; then
        yabai --start-service || true
        echo "  - Yabai service started."
    else
        echo "  - Yabai not found, skipping service start."
    fi
else
    echo "› Intel Mac detected. Skipping Yabai service."
fi

# -----------------------------------------------------------
# 4. Lazygit 設定檔連結 (跨平台相容)
# -----------------------------------------------------------
echo "› Linking Lazygit config..."

# A. 標準路徑 (~/.config/lazygit)
mkdir -p "$HOME/.config/lazygit"
# 備份舊檔
if [ -f "$HOME/.config/lazygit/config.yml" ] && [ ! -L "$HOME/.config/lazygit/config.yml" ]; then
    mv "$HOME/.config/lazygit/config.yml" "$HOME/.config/lazygit/config.yml.bak"
fi
ln -sf "$DOTFILES_ROOT/lazygit/config.yml" "$HOME/.config/lazygit/config.yml"

# B. macOS 特殊路徑 fix (Application Support)
if [ "$(uname)" = "Darwin" ]; then
    echo "  - Fixing Lazygit path for macOS (Application Support)..."
    MAC_TARGET_DIR="$HOME/Library/Application Support/lazygit"
    mkdir -p "$MAC_TARGET_DIR"
    
    # 清理舊的 Application Support 設定，確保它指向我們的新連結
    # 注意：這裡直接強制覆蓋，因為我們已經在上面 .config 備份過了，且兩者應同步
    ln -sf "$DOTFILES_ROOT/lazygit/config.yml" "$MAC_TARGET_DIR/config.yml"
fi

echo "🔗 Lazygit config linked!"

# -----------------------------------------------------------
# 4b. McBopomofo 手動加詞資料檔連結 (macOS Only)
# -----------------------------------------------------------
if [ "$(uname)" = "Darwin" ]; then
    echo "› Linking McBopomofo data.txt..."
    MCBOPOMOFO_TARGET_DIR="$HOME/Library/Application Support/McBopomofo"
    mkdir -p "$MCBOPOMOFO_TARGET_DIR"
    
    # 備份舊檔（非 symlink 時才備份）
    if [ -f "$MCBOPOMOFO_TARGET_DIR/data.txt" ] && [ ! -L "$MCBOPOMOFO_TARGET_DIR/data.txt" ]; then
        mv "$MCBOPOMOFO_TARGET_DIR/data.txt" "$MCBOPOMOFO_TARGET_DIR/data.txt.bak"
    fi
    ln -sf "$DOTFILES_ROOT/mcbopomofo/data.txt" "$MCBOPOMOFO_TARGET_DIR/data.txt"
    echo "🔗 McBopomofo data.txt linked!"
fi

# -----------------------------------------------------------
# 5. 執行其他子安裝腳本 (Sub-installers)
# -----------------------------------------------------------
# 同意 Xcode 授權
echo "› Accepting Xcode license..."
if command -v xcodebuild >/dev/null 2>&1; then
    sudo xcodebuild -license accept || true
fi

echo "› Running sub-installers... | 執行子安裝腳本..."
# 搜尋所有 install.sh，排除 .git 目錄，並自動賦予執行權限
find . -name "install.sh" -not -path '*/.git/*' | while read installer; do
    echo "  - Running ${installer}..."
    chmod +x "${installer}" # 自動修復權限問題
    bash -c "${installer}"
done

echo "› Done! | 安裝完成！"

# -----------------------------------------------------------
# Post-Installation Checks (手動安裝提醒)
# -----------------------------------------------------------

echo ""
echo "=================================================================="
echo "✋ MANUAL ACTION REQUIRED (需要手動執行的項目)"
echo "=================================================================="

# 1. 檢查 Squash 2
if [ -d "/Applications/Squash.app" ]; then
    echo "✅ [已安裝] Squash 2"
else
    echo "❌ [未安裝] Squash 2 (Legacy Version)"
    echo "   👉 原因: 舊版已從商店索引移除，mas 指令無法下載。"
    echo "   👉 動作: 請開啟 App Store -> 帳號 -> 已購項目 -> 手動下載。"
fi

# 2. 檢查 Git User Email
if git config --global user.email > /dev/null 2>&1; then
    echo "✅ [已設定] Git User Email"
else
    echo "❌ [未設定] Git User Email"
    echo "   👉 動作: git config --global user.email 'your@email.com'"
fi

# 3. 檢查字體
if [ -d "$HOME/Library/Fonts/MapleMono-NF-CN-Regular.ttf" ] || \
   [ -f "$HOME/Library/Fonts/MapleMono-NF-CN-Regular.ttf" ]; then
    echo "✅ [已安裝] Maple Mono NF CN"
else
    echo "ℹ️  [檢查] 如果字體顯示異常，請確認字體是否已正確載入。"
fi

echo "=================================================================="
echo ""